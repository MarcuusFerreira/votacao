# Load balancer for compose.prod.yaml. HTTP only; replacing ":80" with a domain name makes Caddy
# obtain and renew an HTTPS certificate automatically.
:80 {
	reverse_proxy {
		# Every replica of the "app" service, re-resolved through Docker's DNS every few seconds.
		dynamic a {
			name app
			port 8080
			refresh 5s
		}
		lb_policy round_robin

		# A replica that refuses connections is skipped for a while; requests that could not
		# reach a replica are retried on another one, so a restarting replica is not noticed.
		fail_duration 10s
		max_fails 1
		lb_try_duration 5s
	}
}
