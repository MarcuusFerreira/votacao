# Copy to .env on the server and fill in. Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=
VOTING_CPF_HASH_KEY=
# Address the app reaches the API at, used in every screen's callback URL (no trailing slash).
VOTING_PUBLIC_BASE_URL=http://<ip-publico-da-vm>
# Host port published by the load balancer (80 by default).
APP_PORT=80
# API replicas behind the load balancer and connection pool size of each one. Keep
# API_REPLICAS x API_POOL_SIZE below Postgres' max_connections (150).
API_REPLICAS=3
API_POOL_SIZE=20
# Memory limit of each API replica (the heap takes 60% of it).
API_MEMORY_LIMIT=512m
VOTING_MEMBER_VERIFICATION_ENABLED=false
